# TalkTranslate Environment Variables Template (.env.example)

# Server Configuration
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/talktranslate_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
SHOW_SQL=false

# JWT / Security Configuration
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Thread Pool Configuration (Optional)
THREAD_POOL_CORE=4
THREAD_POOL_MAX=16
THREAD_POOL_QUEUE=100
